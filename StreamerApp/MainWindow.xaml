<Window x:Class="StreamerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreamerApp"
        mc:Ignorable="d"
        Title="Демонстрация экрана — Панель управления"
        Height="740" Width="1120"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        Foreground="#F3F4F6">

    <Window.Resources>
        <!-- Sleek Dark Gray & Black Palette -->
        <SolidColorBrush x:Key="BgCanvas" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="BgCard" Color="#161616"/>
        <SolidColorBrush x:Key="BgCardElevated" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BgSurface" Color="#222222"/>
        <SolidColorBrush x:Key="BgHover" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BorderLight" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessGreenHover" Color="#059669"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerRedHover" Color="#DC2626"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- Rounded Card Style -->
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Modern Primary Button -->
        <Style x:Key="ModernButton" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
        </Style>

        <!-- Dark Gray Outline Button -->
        <Style x:Key="GrayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Custom ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6" Background="#1B1B1B" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="Transparent" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource TextSecondary}" Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderLight}" />
                    <Setter TargetName="Arrow" Property="Fill" Value="White" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                    <Setter TargetName="Arrow" Property="Fill" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButtonTemplate}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,3,28,3" Focusable="True" Background="Transparent" Foreground="{StaticResource TextPrimary}" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#181818" BorderThickness="1" BorderBrush="{StaticResource BorderLight}" CornerRadius="6" Margin="0,4,0,0"/>
                                    <ScrollViewer Margin="4,6,4,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Border" Padding="10,7" Margin="2,1" CornerRadius="4" Background="Transparent">
                            <ContentPresenter ContentSource="Content">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style (Clean, non-clipping text box) -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Dark Styles -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#242424"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem Transparent Dark Style -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand / Logo (Title Only, No Subtitle Description) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" Background="#1E1E1E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                    <Path HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource AccentBlue}"
                          Data="M2,3 H22 A1,1 0 0,1 23,4 V16 A1,1 0 0,1 22,17 H15 L16,21 H8 L9,17 H2 A1,1 0 0,1 1,16 V4 A1,1 0 0,1 2,3 Z M3,5 V15 H21 V5 Z"/>
                </Border>
                <TextBlock Text="Демонстрация экрана" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Header Indicators: Live Status & Server Web Client Pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status Badge -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusBadgeDot" Width="8" Height="8" Fill="{StaticResource TextMuted}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusBadgeText" Text="Трансляция остановлена" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- URL Pill -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Веб-клиент: " FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="ServerUrlText" Text="http://localhost:5000" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}"/>
                        <Button x:Name="BtnCopyLink" Content="Скопировать" Margin="8,0,0,0" Padding="8,2" FontSize="11" Style="{StaticResource GrayButton}" Click="BtnCopyLink_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ROW 1: SPLIT DASHBOARD (LEFT: STREAM CONTROL & SETTINGS, RIGHT: CHAT & VIEWERS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="580" MinWidth="480"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: STREAM CONTROLS (NO SCROLLBAR)    -->
            <!-- ============================================== -->
            <Grid Grid.Column="0">
                <StackPanel VerticalAlignment="Top">
                    <!-- CARD 1: BROADCAST CONTROL CARD (START/STOP, PAUSE, CODE, COUNTERS) -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Big Start/Stop/Pause Button + Timer Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Big Toggle Start / Stop Button -->
                                <Button x:Name="BtnStartStopBroadcast"
                                        Grid.Column="0"
                                        Content="Начать трансляцию"
                                        Style="{StaticResource SuccessButton}"
                                        FontSize="14"
                                        Height="48"
                                        Margin="0,0,8,0"
                                        Click="BtnStartStopBroadcast_Click"/>

                                <!-- Pause Button -->
                                <Button x:Name="BtnPauseBroadcast"
                                        Grid.Column="1"
                                        Content="Пауза"
                                        Style="{StaticResource GrayButton}"
                                        FontSize="13"
                                        Height="48"
                                        MinWidth="95"
                                        Margin="0,0,10,0"
                                        Padding="14,8"
                                        IsEnabled="False"
                                        Click="BtnPauseBroadcast_Click"/>

                                <!-- Duration Timer Box -->
                                <Border Grid.Column="2" Background="#101010" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="105">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="ВРЕМЯ ЭФИРА" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBroadcastDuration" Text="00:00:00" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Room Code Row (Generous height & width, never cropped) -->
                            <Border Background="#121212" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="КОД ПОДКЛЮЧЕНИЯ ДЛЯ ЗРИТЕЛЕЙ:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtRoomCode"
                                                 Text="734-921"
                                                 FontSize="22"
                                                 FontWeight="Bold"
                                                 FontFamily="Consolas, Courier New"
                                                 Width="150"
                                                 Height="44"
                                                 Padding="4,2"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 TextAlignment="Center"
                                                 TextChanged="TxtRoomCode_TextChanged"/>
                                    </StackPanel>

                                    <!-- Code Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button x:Name="BtnGenCode"
                                                Content="Новый код"
                                                Style="{StaticResource GrayButton}"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Padding="12,6"
                                                Click="BtnGenCode_Click"/>
                                        <Button x:Name="BtnCopyCodeLink"
                                                Content="Копировать ссылку с кодом"
                                                Style="{StaticResource ModernButton}"
                                                Height="38"
                                                Padding="12,6"
                                                Click="BtnCopyCodeLink_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Clean Quick Counters Row (Removed "ПОДКЛЮЧЕНО" and "ТРЕБУЮТ ВНИМАНИЯ") -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Viewers Count Card -->
                                <Border Grid.Column="0" Background="#121212" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Зрители" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtViewersCount" Grid.Column="1" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Raised Hands Count Card -->
                                <Border Grid.Column="2" Background="#121212" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Поднятых рук" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHandsCount" Grid.Column="1" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningAmber}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: REAL-TIME TELEMETRY (FPS, BITRATE, WEBRTC) -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: FPS & Engine -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="ЧАСТОТА (FPS)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusFps" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock x:Name="StatusBackend" Text="DXGI (GPU)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource BorderSubtle}" Width="1" Margin="4,2"/>

                            <!-- Metric 2: Bitrate -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="БИТРЕЙТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusBitrate" Text="0 Кбит/с" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="{StaticResource BorderSubtle}" Width="1" Margin="4,2"/>

                            <!-- Metric 3: WebRTC Peers -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="WEBRTC ПИРЫ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusPeers" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARD 3: COLLAPSIBLE CAPTURE SETTINGS -->
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <!-- Collapsible Header / Toggle -->
                            <Button x:Name="BtnToggleSettings"
                                    Click="BtnToggleSettings_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="14,10"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,0,0">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource TextSecondary}" Margin="0,0,10,0"
                                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                                        <TextBlock Text="Параметры захвата и качества" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSettingsChevron" Grid.Column="1" Text="▲" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Collapsible Content -->
                            <StackPanel x:Name="PanelSettingsContent" Margin="14,0,14,14">
                                <Border Background="{StaticResource BorderSubtle}" Height="1" Margin="0,0,0,10"/>

                                <!-- Video Settings -->
                                <TextBlock Text="Выбор экрана (монитора):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbMonitors" Margin="0,0,0,10" SelectionChanged="CmbMonitors_SelectionChanged"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Resolution -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Разрешение:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbResolution" SelectionChanged="CmbResolution_SelectionChanged">
                                            <ComboBoxItem Content="1920x1080 (Full HD)" IsSelected="True" Tag="1920x1080"/>
                                            <ComboBoxItem Content="1280x720 (HD Ready)" Tag="1280x720"/>
                                            <ComboBoxItem Content="Исходное экрана" Tag="Original"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Target FPS -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Частота кадров:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbFps" SelectionChanged="CmbFps_SelectionChanged">
                                            <ComboBoxItem Content="60 FPS" Tag="60"/>
                                            <ComboBoxItem Content="30 FPS (Оптимально)" IsSelected="True" Tag="30"/>
                                            <ComboBoxItem Content="15 FPS (Экономно)" Tag="15"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Capture Engine & Cursor Controls -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Engine Selector -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Движок захвата:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbCaptureEngine" SelectionChanged="CmbCaptureEngine_SelectionChanged">
                                            <ComboBoxItem Content="DXGI GPU (Аппаратный)" IsSelected="True" Tag="DXGI"/>
                                            <ComboBoxItem Content="GDI CPU (Совместимый)" Tag="GDI"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Cursor Toggle CheckBox -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,16,0,0">
                                        <CheckBox x:Name="ChkShowCursor"
                                                  IsChecked="True"
                                                  Content="Отображать курсор мыши"
                                                  FontSize="11"
                                                  Foreground="{StaticResource TextPrimary}"
                                                  Checked="ChkShowCursor_Changed"
                                                  Unchecked="ChkShowCursor_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bitrate Slider -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Целевой битрейт видео:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtBitrateValue" Grid.Column="1" Text="2500 Кбит/с" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                </Grid>
                                <Slider x:Name="SliderBitrate"
                                        Minimum="500" Maximum="8000" Value="2500" SmallChange="250" LargeChange="1000"
                                        TickFrequency="500" IsSnapToTickEnabled="True"
                                        Margin="0,0,0,10"
                                        ValueChanged="SliderBitrate_ValueChanged"/>

                                <!-- Audio Toggle CheckBox -->
                                <CheckBox x:Name="ChkAudioEnabled"
                                          IsChecked="True"
                                          Content="Передавать системный звук (стерео микшер)"
                                          FontSize="11"
                                          Foreground="{StaticResource TextPrimary}"
                                          Checked="ChkAudioEnabled_Changed"
                                          Unchecked="ChkAudioEnabled_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: CHAT & VIEWERS PANEL             -->
            <!-- ============================================== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP TABS SWITCHER ("Чат" / "Зрители") -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="12,10" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: Chat Button -->
                            <Button x:Name="BtnTabChat"
                                    Grid.Column="0"
                                    Click="BtnTabChat_Click"
                                    Height="36"
                                    Margin="0,0,4,0"
                                    Background="{StaticResource AccentBlue}"
                                    Foreground="White"
                                    Style="{StaticResource ModernButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Чат" FontWeight="SemiBold" FontSize="13"/>
                                    <Border x:Name="BadgeChatUnread" Background="{StaticResource WarningAmber}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtChatUnreadCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#000000"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Viewers Button -->
                            <Button x:Name="BtnTabViewers"
                                    Grid.Column="1"
                                    Click="BtnTabViewers_Click"
                                    Height="36"
                                    Margin="4,0,0,0"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondary}"
                                    Style="{StaticResource GrayButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Зрители" FontWeight="SemiBold" FontSize="13"/>
                                    <Border x:Name="BadgeViewersCount" Background="#2C2C2C" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="TxtBadgeViewers" Text="0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                    <Border x:Name="BadgeHandsIndicator" Background="{StaticResource WarningAmber}" CornerRadius="10" Padding="5,1" Margin="4,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="✋" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- TAB CONTENT 1: CHAT VIEW -->
                    <Grid x:Name="PanelChatView" Grid.Row="1" Margin="14" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Messages List (Telegram/Discord Style Bubbles) -->
                        <ListBox x:Name="LstChat"
                                 Grid.Row="0"
                                 Background="#0F0F0F"
                                 BorderBrush="{StaticResource BorderSubtle}"
                                 BorderThickness="1"
                                 Margin="0,0,0,12"
                                 Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F1F1F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,3">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Sender Name & Host Badge -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Background="#2B392B" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Ведущий" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Timestamp -->
                                                <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Message Text (High Contrast Light Text) -->
                                            <TextBlock Text="{Binding Text}" Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Host Message Input Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtHostMessage"
                                     Grid.Column="0"
                                     Height="38"
                                     Margin="0,0,8,0"
                                     Padding="10,6"
                                     KeyDown="TxtHostMessage_KeyDown"/>

                            <Button x:Name="BtnSendHostMessage"
                                    Grid.Column="1"
                                    Content="Отправить"
                                    Height="38"
                                    Padding="16,8"
                                    Style="{StaticResource ModernButton}"
                                    Click="BtnSendHostMessage_Click"/>
                        </Grid>
                    </Grid>

                    <!-- TAB CONTENT 2: VIEWERS VIEW (COMPACT DATAGRID - REMOVED "Статус" COLUMN) -->
                    <Grid x:Name="PanelViewersView" Grid.Row="1" Margin="14" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Viewers Summary Bar -->
                        <Border Grid.Row="0" Background="#141414" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Текущие активные подключения" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtViewersDetailCount" Grid.Column="1" Text="Всего: 0" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Viewers DataGrid (Columns: Nickname with Hand, IP, RTT, Action) -->
                        <DataGrid x:Name="DgViewers"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Background="#0F0F0F"
                                  BorderBrush="{StaticResource BorderSubtle}"
                                  BorderThickness="1"
                                  RowBackground="#141414"
                                  AlternatingRowBackground="#181818"
                                  Foreground="{StaticResource TextPrimary}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderSubtle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Имя зрителя" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✋ " Foreground="{StaticResource WarningAmber}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHandRaised}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                                <DataGridTextColumn Header="RTT" Binding="{Binding PingMs, StringFormat='{}{0} мс'}" Width="80"/>
                                <DataGridTemplateColumn Header="Действие" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Удалить"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="6,3"
                                                    FontSize="10"
                                                    Click="BtnKickViewer_Click"
                                                    Tag="{Binding ConnectionId}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Статус кодирования: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="VP8 аппаратный/многопоточный" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,14,0"/>

                    <TextBlock Text="Резервный поток: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="1 FPS SignalR (готов)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Сеть: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="StatusNetworkText" Text="LAN 127.0.0.1 : 5000" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
